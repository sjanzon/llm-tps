#!/usr/bin/env python3
"""Live terminal dashboard for a local llama.cpp router (llama-server in router mode).

  llm-tps                full-screen dashboard (keys: q quit · p pause · v view all/log/chart ·
                         1/2/3/4 chart window 1/5/15/60 min · a auto · c reset statistics)
  llm-tps --plain        plain text lines (narrow terminals, logging to a file)
  llm-tps -n 20          print the last 20 answers and events from the log

Options:  --server URL   llama.cpp router address   (env LLM_TPS_SERVER, default http://127.0.0.1:8080)
          --unit NAME    systemd user unit to read  (env LLM_TPS_UNIT,   default llama-router)
"""
import argparse
import collections
import datetime
import json
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import threading
import time
